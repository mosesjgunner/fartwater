# Reown/AppKit Configuration (for wallet connection)
# Get this from: https://cloud.reown.com/
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id
NEXT_PUBLIC_APP_URL=https://fartwater.xyz

# Discord OAuth Configuration
# Get these from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://fartwater.xyz/api/discord/callback

# Optional: Discord Bot Configuration (for assigning roles)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_ROLE_ID=your_role_id_to_assign

# Optional: Admin access for one-time bonus URL generation (comma-separated)
# You can use one or more of these allowlists.
ADMIN_USER_IDS=
ADMIN_DISCORD_IDS=
ADMIN_DISCORD_NAMES=
ADMIN_WALLET_ADDRESSES=

# Printify storefront configuration (for main website merch section)
# Get your API token from: https://printify.com/app/account/api
PRINTIFY_API_TOKEN=your_printify_api_token
# Optional: use a specific shop ID (if omitted, the first shop on the account is used)
PRINTIFY_SHOP_ID=
# Optional: public storefront URL to build product links (example: https://yourbrand.printify.me)
PRINTIFY_STOREFRONT_URL=
